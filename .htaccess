# Apache 2.4. O PHP continua podendo ler esses arquivos pelo filesystem.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule "(^|/)\.(?!well-known(?:/|$))" - [F,L]
</IfModule>
<FilesMatch "(?i)\.(sql|ini|env|log|bak|backup|zip|key|pem)$">
    Require all denied
</FilesMatch>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
